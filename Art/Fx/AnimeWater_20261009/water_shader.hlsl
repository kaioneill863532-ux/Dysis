float2 mapUV=(P.xy-float2(-1100,-1100))/2200;
float4 shore=Texture2DSample(Shore,ShoreSampler,mapUV);
float2 flow=Texture2DSample(Flow,FlowSampler,mapUV).rg*2-1;
flow=normalize(lerp(normalize(FlowDirection.xy),flow,LocalFlowStrength));
float2 uv=P.xy/max(RepeatCm,100);
float phase0=frac(T/max(CycleSeconds,1));
float phase1=frac(T/max(CycleSeconds,1)+.5);
float w0=1-abs(2*phase0-1);
float w1=1-abs(2*phase1-1);
float2 wobble=WarpStrength*float2(sin(6.283185*(uv.y+T/CycleSeconds)),cos(6.283185*(uv.x+T/CycleSeconds)));
// Two offset phases fade to zero before each advection reset. No stretched accumulation.
float2 q0=uv-flow*(MainSpeedCm*(1+FlowState*.45)*CycleSeconds/RepeatCm)*phase0+wobble;
float2 q1=uv-flow*(MainSpeedCm*(1+FlowState*.45)*CycleSeconds/RepeatCm)*phase1+wobble;
float4 s0=Texture2DSample(Shapes,ShapesSampler,q0);
float4 s1=Texture2DSample(Shapes,ShapesSampler,q1);
float4 s=(s0*w0+s1*w1)/max(w0+w1,.001);
float phase2=frac(T/CycleSeconds+.27),phase3=frac(T/CycleSeconds+.77);
float w2=1-abs(phase2*2-1),w3=1-abs(phase3*2-1);
float2 drift2=normalize(float2(-.45,.89));
float4 b0=Texture2DSample(Shapes,ShapesSampler,uv*.72+float2(.31,.42)-drift2*(SecondSpeedCm*(1+FlowState*.25)*CycleSeconds/RepeatCm)*phase2-wobble*.6);
float4 b1=Texture2DSample(Shapes,ShapesSampler,uv*.72+float2(.31,.42)-drift2*(SecondSpeedCm*(1+FlowState*.25)*CycleSeconds/RepeatCm)*phase3-wobble*.6);
float4 b=(b0*w2+b1*w3)/max(w2+w3,.001);
float region=smoothstep(.24,.68,lerp(s.r,b.r,.35));
float3 color=lerp(DeepColor.rgb,MainColor.rgb,region);
color=lerp(color,ShallowColor.rgb,shore.g*.72);
float aa=max(fwidth(s.g),.025);
float stripe=smoothstep(.12-aa,.32+aa,s.g);
float line2=smoothstep(.15-aa,.4+aa,b.g)*.45;
float density=smoothstep(1-saturate(LineDensity+RippleState*.07)-.08,1-saturate(LineDensity+RippleState*.07)+.08,b.r);
float distanceCm=shore.r*200;
float shoreRange=1-smoothstep(ShoreWidthCm*.35,ShoreWidthCm,distanceCm);
float interrupted=.35+.65*smoothstep(.3,.7,b.r);
float contact=shoreRange*interrupted*(.65+.35*sin(6.283185*(T/CycleSeconds)+P.x*.006+P.y*.004));
float highlights=saturate(max(stripe,line2)*density*.58+contact*.58);
color=lerp(color,LineColor.rgb,highlights);
float warm=shore.b*saturate((stripe*.75+line2*.4+contact*.12)*WarmReflectionStrength);
color=lerp(color,WarmColor.rgb,warm);
return color;
